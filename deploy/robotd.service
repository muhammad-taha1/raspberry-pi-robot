[Unit]
Description=raspberry-pi-robot daemon
After=network.target

[Service]
Type=simple
# Adjust WorkingDirectory/User to match where the repo is cloned on the Pi.
WorkingDirectory=/home/taha/robot
ExecStart=/home/taha/robot/.venv/bin/python -m robotd
Restart=on-failure
RestartSec=2
User=taha
# Load Needle/Whisper weights from the local cache only; deploy.sh pre-fetches.
Environment=HF_HUB_OFFLINE=1

[Install]
WantedBy=multi-user.target
